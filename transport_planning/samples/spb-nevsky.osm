 <node id="9784449095" visible="true" version="14" changeset="141361632" timestamp="2023-09-16T23:16:38Z" user="traveleditor" uid="8726248" lat="59.9264875" lon="30.3428684">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В этом доме с сентября 1935 года жили: до мая 1941 года писательница Лидия Корнеевна Чуковская /1907-1996/, до ареста в августе 1937 года физик-теоретик Матвей Петрович Бронштейн /1906-1938, расстрелян/. Здесь в 1939-40 была написана &quot;Софья Петровна&quot;..."/>
