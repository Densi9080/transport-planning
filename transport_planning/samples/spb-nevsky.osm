  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В этом доме в 1906–1907 годах находилось большевистское издательство «Вперед». Редакционный совет издательства возглавлял В. И. Ленин. Он часто работал здесь и встречался с товарищами. В марте 1906 года в помещении издательства Ленин провел совещание ..."/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Издательству «Вперед»"/>
 </node>
