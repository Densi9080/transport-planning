  <tag k="inscription" v="В этом доме с 1775 г. по 1790 г. жил выдающийся русский писатель-революционер Александр Николаевич Радищев. Здесь он напечатал в собственной типографии книгу Путешествие из Петербурга в Москву"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Александр Николаевич Радищев"/>
  <tag k="name" v="А. Н. Радищеву"/>
  <tag k="subject:wikidata" v="Q217470"/>
  <tag k="subject:wikipedia" v="ru:Радищев, Александр Николаевич"/>
 </node>
